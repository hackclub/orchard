model Database {
  id                     String    @id @default(uuid()) @db.Uuid
  projectId              String    @map("project_id") @db.Uuid
  name                   String    @db.VarChar(255)
  dbName                 String    @map("db_name") @db.VarChar(63)
  dbUser                 String    @map("db_user") @db.VarChar(63)
  dbPassword             String    @map("db_password") @db.Text
  status                 String    @default("pending") @db.VarChar(50)
  host                   String    @default("postgresql-cluster-rw.postgresql.svc.cluster.local") @db.VarChar(255)
  port                   Int       @default(5432)
  mode                   String    @default("shared") @db.VarChar(20)
  namespace              String?   @db.VarChar(100)
  // Scheduling: friendly node pool + superadmin-only raw placement escape hatch.
  // Injected into the CNPG Cluster CR's spec.affinity at reconcile time.
  nodePoolId             String?   @map("node_pool_id") @db.Uuid
  placementOverride      Json?     @map("placement_override") @db.JsonB
  containerName          String?   @map("container_name") @db.VarChar(100)
  storageSize            String?   @map("storage_size") @db.VarChar(20)
  clusterName            String?   @map("cluster_name") @db.VarChar(100)
  clusterStatus          Json?     @map("cluster_status")
  clusterSyncedAt        DateTime? @map("cluster_synced_at") @db.Timestamp(6)
  sizeBytes              BigInt?   @map("size_bytes")
  connections            Int?
  statsAt                DateTime? @map("stats_at") @db.Timestamp(6)
  volumeUsedBytes        BigInt?   @map("volume_used_bytes")
  volumeCapacityBytes    BigInt?   @map("volume_capacity_bytes")
  walPendingSegments     Int?      @map("wal_pending_segments")
  // Total CNPG instances: 1 primary + (replicas - 1) hot standbys. Every
  // instance gets its own pod and its own PVC, so this multiplies the
  // cluster's CPU/memory footprint against the org cap and member allowance.
  replicas               Int       @default(1)
  pgMajor                Int       @default(17) @map("pg_major")
  pgParameters           Json?     @map("pg_parameters")
  sharedPreloadLibs      Json?     @map("shared_preload_libs")
  installedExtensions    Json?     @map("installed_extensions")
  backupScheduleCron     String?   @map("backup_schedule_cron") @db.VarChar(100)
  backupScheduleDisabled Boolean   @default(false) @map("backup_schedule_disabled")
  // Compression for the *base* backup, which barman streams through gzip inside
  // the postgres container's own cgroup. null means derive it from the memory
  // limit (see kubernetes/db-tuning.ts); 'gzip' or 'none' is the user overriding
  // that call and is honoured as-is. WAL compression is always on and is not
  // covered by this.
  backupCompression      String?   @map("backup_compression") @db.VarChar(10)

  // Resources were raised above the user's request for the initial import;
  // the settle loop scales the cluster back down once bootstrap completes.
  importBoosted        Boolean   @default(false) @map("import_boosted")
  publicEnabled        Boolean   @default(false) @map("public_enabled")
  publicIp             String?   @map("public_ip") @db.VarChar(45)
  publicPort           Int?      @map("public_port")
  cpuRequestMilli      Int?      @map("cpu_request_milli")
  memoryRequestBytes   BigInt?   @map("memory_request_bytes")
  // Per-cluster fake AK/SK presented to barman when BACKUP_PROXY_ENABLED=true.
  // Real R2 credentials never live in the cluster's namespace.
  r2ProxyAccessKey     String?   @map("r2_proxy_access_key") @db.VarChar(64)
  r2ProxySecret        String?   @map("r2_proxy_secret") @db.VarChar(128)
  r2RestoreAccessKey   String?   @map("r2_restore_access_key") @db.VarChar(64)
  r2RestoreSecret      String?   @map("r2_restore_secret") @db.VarChar(128)
  r2RestoreClusterName String?   @map("r2_restore_cluster_name") @db.VarChar(100)
  backupServerName     String?   @map("backup_server_name") @db.VarChar(100)
  backupMethod         String?   @map("backup_method") @db.VarChar(20)
  deletionProtection   Boolean   @default(false) @map("deletion_protection")
  ddlCheckpoints       Boolean   @default(true) @map("ddl_checkpoints")
  ddlGuardVersion      Int?      @map("ddl_guard_version")
  restoreTests         Boolean   @default(true) @map("restore_tests")
  poolerEnabled        Boolean   @default(false) @map("pooler_enabled")
  poolerConfig         Json?     @map("pooler_config") @db.JsonB
  forkedFromId         String?   @map("forked_from_id") @db.Uuid
  forkedAt             DateTime? @map("forked_at") @db.Timestamp(6)
  createdBy            String?   @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  templateInstanceId String? @map("template_instance_id") @db.Uuid
  environmentId      String? @map("environment_id") @db.Uuid

  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment      Environment?        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  creator          User?               @relation("DatabaseCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  templateInstance TemplateInstance?   @relation(fields: [templateInstanceId], references: [id], onDelete: SetNull)
  nodePool         NodePool?           @relation(fields: [nodePoolId], references: [id], onDelete: SetNull)
  backups          DatabaseBackup[]
  pods             DatabasePod[]
  crashState       DatabaseCrashState?

  @@unique([environmentId, name])
  @@index([projectId], map: "idx_databases_project")
  @@index([environmentId], map: "idx_databases_environment")
  @@index([templateInstanceId], map: "idx_databases_template_instance")
  @@index([publicIp, publicPort], map: "idx_databases_public_endpoint")
  @@index([nodePoolId], map: "idx_databases_node_pool")
  @@index([r2ProxyAccessKey], map: "idx_databases_r2_proxy_access_key")
  @@index([r2RestoreAccessKey], map: "idx_databases_r2_restore_access_key")
  @@map("databases")
}

