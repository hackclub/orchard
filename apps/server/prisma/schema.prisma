  provider     IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([providerId, projectId, value])
  @@index([organizationId], map: "idx_idp_project_rules_org")
  @@map("idp_project_rules")
}

model Project {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @db.VarChar(100)
  description      String?  @db.Text
  repositoryUrl    String?  @map("repository_url") @db.VarChar(500)
  icon             String?  @db.VarChar(500)
  backgroundImage  String?  @map("background_image") @db.VarChar(1000)
  namespace        String   @db.VarChar(100)
  // Per-project caps: override the org-level share (null = inherit from org).
  cpuLimitMilli    Int?     @map("cpu_limit_milli")
  memoryLimitBytes BigInt?  @map("memory_limit_bytes")
  maxPods          Int?     @map("max_pods")
  maxServices      Int?     @map("max_services")
  createdBy        String?  @map("created_by") @db.Uuid
  // Project owner: deployments under this project are accredited to this user's allowance.
  // Backfilled from createdBy on migration; transferable later.
  ownerId          String?  @map("owner_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator             User?                    @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  owner               User?                    @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members             ProjectMember[]
  idpProjectRules     IdpProjectRule[]
  invitations         ProjectInvitation[]
  transferRequests    ProjectTransferRequest[]
  orgInvitations      OrganizationInvitation[]
  deployments         Deployment[]
  ingresses           Ingress[]
  databases           Database[]
  deletedDatabases    DeletedDatabase[]
  templateInstances   TemplateInstance[]
  composeStacks       ComposeStack[]
  jobs                Job[]
  environments        Environment[]
  registryCredentials RegistryCredential[]

  @@unique([organizationId, slug])
  @@index([organizationId], map: "idx_projects_organization")
  @@map("projects")
}

model OrganizationRegistryCredential {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  registry       String       @db.VarChar(255)
  username       String       @db.VarChar(255)
  password       String       @db.Text
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, registry])
  @@map("organization_registry_credentials")
}

model RegistryCredential {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  // Normalised registry host: "ghcr.io", "docker.io", "registry.gitlab.com".
  registry  String   @db.VarChar(255)
  username  String   @db.VarChar(255)
  // Encrypted at rest with SecretCryptoService; never returned by the API.
  password  String   @db.Text
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, registry])
  @@index([projectId], map: "idx_registry_credentials_project")
  @@map("registry_credentials")
}

model Environment {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  name             String   @db.VarChar(100)
  slug             String   @db.VarChar(100)
  // The k8s namespace this environment's resources live in. For the default
  // production environment this equals the project's original namespace
  // (zero-churn retrofit); new environments get a suffixed namespace.
  namespace        String   @unique @db.VarChar(100)
  isDefault        Boolean  @default(false) @map("is_default")
  isProduction     Boolean  @default(false) @map("is_production")
  // Per-env caps override the project's share (null = inherit project → org).
  cpuLimitMilli    Int?     @map("cpu_limit_milli")
  memoryLimitBytes BigInt?  @map("memory_limit_bytes")
  maxPods          Int?     @map("max_pods")
  maxServices      Int?     @map("max_services")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments   Deployment[]
  databases     Database[]
  ingresses     Ingress[]
  jobs          Job[]
  sharedVars    EnvironmentSharedVar[]
  composeStacks ComposeStack[]

  @@unique([projectId, slug])
  @@index([projectId], map: "idx_environments_project")
  @@map("environments")
}

model EnvironmentSharedVar {
  id            String   @id @default(uuid()) @db.Uuid
  environmentId String   @map("environment_id") @db.Uuid
  key           String   @db.VarChar(255)
  value         String   @db.Text
  secret        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([environmentId], map: "idx_environment_shared_vars_environment")
  @@map("environment_shared_vars")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamp(6)
  addedBy   String?  @map("added_by") @db.Uuid

  managedByProviderId String? @map("managed_by_provider_id") @db.Uuid

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  adder             User?             @relation("ProjectMemberAdder", fields: [addedBy], references: [id], onDelete: SetNull)
  managedByProvider IdentityProvider? @relation(fields: [managedByProviderId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId], map: "idx_project_members_project")
  @@index([userId], map: "idx_project_members_user")
  @@map("project_members")
}

// Ownership moves in two steps: the current owner (or an org admin) opens a
// request, and the recipient accepts it. Ownership decides whose resource
// allowance the project's pods are billed against, so it is never something
// that can be pushed onto someone without their consent.
model ProjectTransferRequest {
  id          String                @id @default(uuid()) @db.Uuid
  projectId   String                @map("project_id") @db.Uuid
  fromUserId  String                @map("from_user_id") @db.Uuid
  toUserId    String                @map("to_user_id") @db.Uuid
  status      ProjectTransferStatus @default(pending)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  expiresAt   DateTime              @map("expires_at") @db.Timestamp(6)
  respondedAt DateTime?             @map("responded_at") @db.Timestamp(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from    User    @relation("ProjectTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to      User    @relation("ProjectTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_project_transfers_project")
  @@index([toUserId, status], map: "idx_project_transfers_recipient")
  @@map("project_transfer_requests")
}

enum ProjectTransferStatus {
  pending
  accepted
  declined
  canceled

  @@map("project_transfer_status")
}

model ProjectInvitation {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  invitedBy String   @map("invited_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectInvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  inviter User    @relation("ProjectInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId], map: "idx_project_invitations_project")
  @@index([userId], map: "idx_project_invitations_user")
  @@map("project_invitations")
}

model Deployment {
  id                   String             @id @default(uuid()) @db.Uuid
  projectId            String             @map("project_id") @db.Uuid
  name                 String             @db.VarChar(255)
  // User-facing name, renamable at any time. `name` stays frozen after
  // creation because it is baked into the k8s object names (Deployment,
  // Service, selectors, env Secret). Render displayName ?? name.
  displayName          String?            @map("display_name") @db.VarChar(255)
  icon                 String?            @db.VarChar(500)
  namespace            String             @db.VarChar(100)
  image                String?            @db.VarChar(500)
  replicas             Int                @default(1)
  stopped              Boolean            @default(false)
  createdByGraft       String?            @map("created_by_graft") @db.VarChar(255)
  pendingPush          Json?              @map("pending_push")
  // Per-container resource request (== limit; Guaranteed QoS).
  // Null means fall back to org defaultPodCpuMilli/defaultPodMemoryBytes, then 100m/128Mi.
  cpuRequestMilli      Int?               @map("cpu_request_milli")
  memoryRequestBytes   BigInt?            @map("memory_request_bytes")
  status               String             @default("pending") @db.VarChar(50)
  // Scheduling: friendly node pool + superadmin-only raw placement escape hatch
  // ({ nodeSelector?, tolerations?, affinity? } deep-merged over the resolved placement).
  nodePoolId           String?            @map("node_pool_id") @db.Uuid
  placementOverride    Json?              @map("placement_override") @db.JsonB
  devices              Json               @default("{}") @db.JsonB
  buildStatus          String             @default("none") @map("build_status") @db.VarChar(50)
  buildStep            String?            @map("build_step") @db.VarChar(50)
  buildType            BuildType          @default(dockerfile) @map("build_type")
  deployStrategy       DeploymentStrategy @default(rollingUpdate) @map("deploy_strategy")
  // How many pods must stay ready through a voluntary disruption (node drain,
  // cluster upgrade). 0 means no PodDisruptionBudget at all. The budget is
  // only written when `replicas` exceeds it: one that asks for every pod the
  // app has leaves zero allowed disruptions and blocks the drain forever,
  // which is why the chart's own PDBs are gated on replicas > 1 too.
  pdbMinAvailable      Int                @default(1) @map("pdb_min_available")
  // null means "derive it from the image tag": Always for a tag that can move
  // (`latest`, `main`, a floating major), IfNotPresent otherwise. A concrete
  // value is the user overriding that and is never recomputed.
  //
  // GitHub builds get a unique v<timestamp> tag per build, so they derive to
  // IfNotPresent and re-pulling would be pure waste.
  imagePullPolicy      ImagePullPolicy?   @map("image_pull_policy")
  imageAutoUpdate      Boolean            @default(false) @map("image_auto_update")
  imageCheckedRef      String?            @map("image_checked_ref") @db.VarChar(500)
  imageRunningDigest   String?            @map("image_running_digest") @db.VarChar(100)
  imageLatestDigest    String?            @map("image_latest_digest") @db.VarChar(100)
  imageAttemptedDigest String?            @map("image_attempted_digest") @db.VarChar(100)
  imageCheckedAt       DateTime?          @map("image_checked_at") @db.Timestamp(6)
  imageCheckError      String?            @map("image_check_error") @db.VarChar(100)
  imageUpdatedAt       DateTime?          @map("image_updated_at") @db.Timestamp(6)
  envObservedHash      String?            @map("env_observed_hash") @db.VarChar(64)
  envConflicts         Json?              @map("env_conflicts") @db.JsonB
  githubRepo           String?            @map("github_repo") @db.VarChar(500)
  // GitHub's numeric repository id, the only part of a repo that survives a
  // rename. Auto-deploy matches on this first and on `githubRepo` second, so
  // renaming a repo on GitHub does not silently detach its deployments.
  githubRepoId         BigInt?            @map("github_repo_id")
  githubBranch         String?            @map("github_branch") @db.VarChar(255)
  dockerfilePath       String?            @map("dockerfile_path") @db.VarChar(500)
  // The stage a multi-stage Dockerfile stops at (`docker build --target`).
  // Null builds the final stage, which is both Docker's default and the only
  // thing a single-stage file can do. Persisted rather than passed per build:
  // it was create-only before, so every rebuild silently dropped the flag and
  // built a different image than the one the deployment was created with.
  dockerfileTarget     String?            @map("dockerfile_target") @db.VarChar(255)
  buildFromRoot        Boolean            @default(false) @map("build_from_root")
  buildWithDepot       Boolean            @default(false) @map("build_with_depot")
  persistentBuildCache Boolean            @default(false) @map("persistent_build_cache")
  builderOverride      String?            @map("builder_override") @db.VarChar(20)
  // Zero-config build settings for `railpack` builds. Every one of these is
  // null by default, meaning "whatever Railpack detected": a non-null value
  // becomes a RAILPACK_* override on the build. Railpack's own merge order
  // (options < env < railpack.json) means a repo that commits a railpack.json
  // still wins over anything set here, which is the intended escape hatch.
  //
  // rootDirectory is the app's directory inside the repo. For a plain repo we
  // point Railpack straight at it; inside a detected workspace we keep the
  // build at the repo root (so the lockfile resolves) and scope the commands
  // to the package instead.
  rootDirectory        String?            @map("root_directory") @db.VarChar(500)
  framework            String?            @map("framework") @db.VarChar(50)
  installCommand       String?            @map("install_command") @db.VarChar(2000)
  buildCommand         String?            @map("build_command") @db.VarChar(2000)
  // The exception to the block above: startCommand applies to every build
  // type, but by two different routes. Railpack bakes it into the image as
  // RAILPACK_START_CMD; a Dockerfile build or an image-source deployment has
  // no builder to bake anything, so it becomes the container's args instead
  // (see kubernetes/start-command.ts) and takes effect on a rollout.
  startCommand         String?            @map("start_command") @db.VarChar(2000)
  // Non-null turns the app into a static site: Railpack builds it, then serves
  // this directory with Caddy on $PORT with index.html fallback.
  outputDirectory      String?            @map("output_directory") @db.VarChar(500)
  // Reconciled from the build's railpack-info.json: what Railpack actually
  // detected, as opposed to what the create-form guessed.
  detectedConfig       Json?              @map("detected_config") @db.JsonB
  // Local-upload builds ("orchard up"): R2 object key + sha256 of the last
  // uploaded build context. A deployment with a key and no githubRepo builds
  // from the uploaded tarball instead of a clone.
  buildContextKey      String?            @map("build_context_key") @db.VarChar(500)
  buildContextSha      String?            @map("build_context_sha") @db.VarChar(100)
  buildLogs            String?            @map("build_logs") @db.Text
  buildError           String?            @map("build_error") @db.Text
  buildStepTimestamps  Json?              @map("build_step_timestamps") @db.JsonB
  createdBy            String?            @map("created_by") @db.Uuid
  applyStatus          String             @default("synced") @map("apply_status") @db.VarChar(20)
  applyError           String?            @map("apply_error") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  // Tailscale integration
  tailscaleExposed   Boolean @default(false) @map("tailscale_exposed")
  tailscaleHostname  String? @map("tailscale_hostname") @db.VarChar(255)
  tailscaleExposedBy String? @map("tailscale_exposed_by") @db.Uuid

  // Auto-deploy configuration
  autoDeployEnabled    Boolean  @default(false) @map("auto_deploy_enabled")
  autoDeployBranch     String?  @map("auto_deploy_branch") @db.VarChar(255)
  autoDeployPaths      String[] @default([]) @map("auto_deploy_paths")
  // GitHub App installation that owns this deployment's repo. Webhooks must
  // be matched against this id to prevent another installation impersonating
  // a repo by full_name.
  githubInstallationId BigInt?  @map("github_installation_id")
  // A git provider other than the GitHub App: the connection that owns the
  // repo's credentials and webhook secret. When set, `githubInstallationId`
  // is null and auto-deploy is scoped to this connection instead.
  gitConnectionId      String?  @map("git_connection_id") @db.Uuid
  repoLinkedBy         String?  @map("repo_linked_by") @db.Uuid
  // The provider's own id for the repo, a string because Bitbucket uses
  // UUIDs. Matched first on push so a rename does not detach the app.
  externalRepoId       String?  @map("external_repo_id") @db.VarChar(120)

  // A push that arrives while a build is in flight parks its commit here
  // instead of being dropped. Coalesces to the latest push (newer supersedes),
  // and drains into a fresh build when the current one settles.
  queuedCommitSha            String?   @map("queued_commit_sha") @db.VarChar(255)
  queuedCommitMessage        String?   @map("queued_commit_message") @db.Text
  queuedCommitAuthorName     String?   @map("queued_commit_author_name") @db.VarChar(255)
  queuedCommitAuthorUsername String?   @map("queued_commit_author_username") @db.VarChar(255)
  queuedAt                   DateTime? @map("queued_at") @db.Timestamp(6)

  // Health check configuration
  healthCheckEnabled      Boolean @default(false) @map("health_check_enabled")
  healthCheckPath         String? @map("health_check_path") @db.VarChar(500)
  healthCheckPort         Int?    @map("health_check_port")
  healthCheckType         String  @default("http") @map("health_check_type") @db.VarChar(20)
  healthCheckCommand      String? @map("health_check_command") @db.VarChar(500)
  livenessEnabled         Boolean @default(true) @map("liveness_enabled")
  readinessEnabled        Boolean @default(true) @map("readiness_enabled")
  startupEnabled          Boolean @default(false) @map("startup_enabled")
  healthCheckInterval     Int     @default(30) @map("health_check_interval")
  healthCheckTimeout      Int     @default(5) @map("health_check_timeout")
  healthCheckRetries      Int     @default(3) @map("health_check_retries")
  startupFailureThreshold Int     @default(30) @map("startup_failure_threshold")
  // The HEALTHCHECK the last build read out of the repo's Dockerfile, if it
  // declared one. It wins over the columns above, because it ships with the
  // code, unless the user says otherwise by setting the override flag.
  dockerfileHealthCheck   Json?   @map("dockerfile_health_check")
  healthCheckOverride     Boolean @default(false) @map("health_check_override")

  templateInstanceId String? @map("template_instance_id") @db.Uuid
  composeStackId     String? @map("compose_stack_id") @db.Uuid
  composeServiceName String? @map("compose_service_name") @db.VarChar(255)
  // Nullable during the expand phase so a rolling deploy of the old code (which
  // doesn't know this column) keeps inserting cleanly. New code always sets it;
  // a later release tightens to NOT NULL once old pods are gone.
  environmentId      String? @map("environment_id") @db.Uuid

  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment       Environment?             @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  creator           User?                    @relation("DeploymentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  templateInstance  TemplateInstance?        @relation(fields: [templateInstanceId], references: [id], onDelete: SetNull)
  composeStack      ComposeStack?            @relation(fields: [composeStackId], references: [id], onDelete: SetNull)
  nodePool          NodePool?                @relation(fields: [nodePoolId], references: [id], onDelete: SetNull)
  pods              Pod[]
  services          Service[]
  envVars           DeploymentEnvVar[]
  ingresses         Ingress[]
  imageHistory      ImageHistory[]
  errorGroups       ErrorGroup[]
  buildRuns         BuildRun[]
  volumes           DeploymentVolume[]
  githubDeployments GitHubDeployment[]
  webhookTokens     DeploymentWebhookToken[]
  jobSteps          JobStep[]
  crashState        DeploymentCrashState?
  releases          Release[]
  resourceBindings  ResourceBinding[]
  clusterEvents     ClusterEvent[]
  gitConnection     GitConnection?           @relation(fields: [gitConnectionId], references: [id], onDelete: SetNull)

  @@unique([environmentId, name])
  @@index([projectId], map: "idx_deployments_project")
  @@index([environmentId], map: "idx_deployments_environment")
  @@index([buildStatus, updatedAt(sort: Desc)], map: "idx_deployments_build_status_updated")
  @@index([githubRepoId], map: "idx_deployments_github_repo_id")
  @@index([nodePoolId], map: "idx_deployments_node_pool")
  @@index([templateInstanceId], map: "idx_deployments_template_instance")
  @@index([composeStackId], map: "idx_deployments_compose_stack")
  @@index([tailscaleExposedBy], map: "idx_deployments_tailscale_exposed_by")
  @@index([createdByGraft], map: "idx_deployments_created_by_graft")
  @@map("deployments")
}

// Track GitHub Deployments API entries for showing status on GitHub
model GitHubDeployment {
  id                 String   @id @default(uuid()) @db.Uuid
  deploymentId       String   @map("deployment_id") @db.Uuid
  githubDeploymentId BigInt   @map("github_deployment_id")
  owner              String   @db.VarChar(255)
  repo               String   @db.VarChar(255)
  ref                String   @db.VarChar(255) // branch or commit sha
  commitSha          String   @map("commit_sha") @db.VarChar(100)
  environment        String   @default("production") @db.VarChar(100)
  status             String   @default("pending") @db.VarChar(50) // pending, in_progress, success, failure, error
  logUrl             String?  @map("log_url") @db.VarChar(500)
  environmentUrl     String?  @map("environment_url") @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, githubDeploymentId])
  @@index([deploymentId], map: "idx_github_deployments_deployment")
  @@index([owner, repo], map: "idx_github_deployments_repo")
  @@map("github_deployments")
}

model ImageHistory {
  id                   String    @id @default(uuid()) @db.Uuid
  deploymentId         String    @map("deployment_id") @db.Uuid
  image                String    @db.VarChar(500)
  tag                  String    @db.VarChar(100)
  commitSha            String?   @map("commit_sha") @db.VarChar(100)
  commitMessage        String?   @map("commit_message") @db.VarChar(500)
  commitAuthorName     String?   @map("commit_author_name") @db.VarChar(255)
  commitAuthorUsername String?   @map("commit_author_username") @db.VarChar(255)
  branch               String?   @db.VarChar(255)
  buildLogs            String?   @map("build_logs") @db.Text
  buildStartedAt       DateTime? @map("build_started_at") @db.Timestamp(6)
  buildCompletedAt     DateTime? @map("build_completed_at") @db.Timestamp(6)
  triggerType          String?   @map("trigger_type") @db.VarChar(20)
  triggeredById        String?   @map("triggered_by_id") @db.Uuid
  isActive             Boolean   @default(false) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  deployment           Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  triggeredBy          User?             @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  errorGroupsFirstSeen ErrorGroup[]
  errorOccurrences     ErrorOccurrence[]
  releases             Release[]

  @@index([deploymentId], map: "idx_image_history_deployment")
  @@index([deploymentId, createdAt], map: "idx_image_history_deployment_date")
  @@index([deploymentId, isActive], map: "idx_image_history_deployment_active")
  @@index([createdAt(sort: Desc)], map: "idx_image_history_created")
  @@map("image_history")
}

// One row per build attempt (auto-deploy push, manual deploy, or rebuild).
// The queue's source of truth: a distributed SKIP LOCKED claimer promotes
// `scheduled` rows to `building` while respecting a global concurrency cap and
// one-active-build-per-deployment. Newer scheduled runs coalesce older ones to
// `skipped`. Heartbeats let a stale-worker sweep reclaim orphaned `building`
// runs. See BuildQueueService.
model BuildRun {
  id           String @id @default(uuid()) @db.Uuid
  deploymentId String @map("deployment_id") @db.Uuid
  // scheduled | building | succeeded | failed | skipped | canceled
  status       String @default("scheduled") @db.VarChar(20)
  // auto | manual | initial
  triggerType  String @map("trigger_type") @db.VarChar(20)

  commitSha            String? @map("commit_sha") @db.VarChar(255)
  commitMessage        String? @map("commit_message") @db.Text
  commitAuthorName     String? @map("commit_author_name") @db.VarChar(255)
  commitAuthorUsername String? @map("commit_author_username") @db.VarChar(255)
  branch               String? @db.VarChar(255)

  triggeredById String? @map("triggered_by_id") @db.Uuid

  // Which server process claimed this run, plus a liveness heartbeat. If the
  // heartbeat goes stale the reclaim sweep fails the run and frees its slot.
  workerId    String?   @map("worker_id") @db.VarChar(120)
  builder     String?   @db.VarChar(20)
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamp(6)

  // GitHub artifacts opened for this run, so the reclaim sweep can close
  // them when the owning process dies mid-build.
  checkRunId           BigInt? @map("check_run_id")
  githubInstallationId BigInt? @map("github_installation_id")
  repoFullName         String? @map("repo_full_name") @db.VarChar(255)

  // Failure message, or the reason a run was skipped/canceled.
  detail String? @db.Text

  logs String? @db.Text

  stepTimestamps Json? @map("step_timestamps") @db.JsonB

  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamp(6)
  startedAt   DateTime? @map("started_at") @db.Timestamp(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  deployment  Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  triggeredBy User?      @relation("BuildRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt], map: "idx_build_runs_claim")
  @@index([deploymentId, status], map: "idx_build_runs_deployment_status")
  @@index([deploymentId, createdAt(sort: Desc)], map: "idx_build_runs_deployment_recent")
  @@index([status, heartbeatAt], map: "idx_build_runs_reclaim")
  @@map("build_runs")
}

// What actually shipped, frozen at the moment traffic moved to it. ImageHistory
// is image plus git provenance and is capped at 10 with older images deleted
// from the registry; a Release keeps the configuration that ran alongside the
// image (env keys, resources, probes, start command, replica count) so a
// rollback can put back the whole thing, and a failed rollout leaves a row
// saying why nothing moved.
model Release {
  id                  String             @id @default(uuid()) @db.Uuid
  deploymentId        String             @map("deployment_id") @db.Uuid
  imageHistoryId      String?            @map("image_history_id") @db.Uuid
  image               String             @db.VarChar(500)
  strategy            DeploymentStrategy @default(rollingUpdate)
  // live | superseded | failed | rolled_back
  status              String             @default("live") @db.VarChar(20)
  // Why a failed release never took traffic, or what a rollback returned to.
  reason              String?            @db.Text
  // Secret values are never snapshotted: entries carry {key, secret: true}.
  envSnapshot         Json               @map("env_snapshot") @db.JsonB
  resourceSnapshot    Json               @map("resource_snapshot") @db.JsonB
  healthCheckSnapshot Json?              @map("health_check_snapshot") @db.JsonB
  startCommand        String?            @map("start_command") @db.VarChar(2000)
  replicas            Int                @default(1)
  createdById         String?            @map("created_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  promotedAt          DateTime?          @map("promoted_at") @db.Timestamp(6)
  supersededAt        DateTime?          @map("superseded_at") @db.Timestamp(6)
  settledAt           DateTime?          @map("settled_at") @db.Timestamp(6)
  verdict             Json?              @db.JsonB
  verdictAt           DateTime?          @map("verdict_at") @db.Timestamp(6)

  deployment   Deployment    @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  imageHistory ImageHistory? @relation(fields: [imageHistoryId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("ReleaseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([deploymentId, createdAt(sort: Desc)], map: "idx_releases_deployment_recent")
  @@index([deploymentId, status], map: "idx_releases_deployment_status")
  @@map("releases")
}

model DeploymentWebhookToken {
  id                    String    @id @default(uuid()) @db.Uuid
  deploymentId          String    @map("deployment_id") @db.Uuid
  // Legacy plaintext column. Kept nullable for rollback safety; new rows
  // write NULL here, old rows are nulled by the 20260515180000 migration
  // after their hash is backfilled. New code must look up by `tokenHash`.
  token                 String?   @unique @db.VarChar(128)
  // SHA-256 hex digest of the plaintext token. Webhook tokens are bearer
  // secrets: storing them in plaintext turns a DB-read foothold (backup
  // leak, replica access) into working triggers.
  tokenHash             String    @unique @map("token_hash") @db.VarChar(128)
  label                 String?   @db.VarChar(100)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamp(6)
  createdByUserId       String?   @map("created_by_user_id") @db.Uuid
  // H-3: when a webhook is minted via an API token (vs a session), record
  // which API token authored it. Revoking the parent API token must also
  // kill any webhooks created with it, otherwise a project-scoped token's
  // deployment-trigger capability outlives the token itself.
  originatingApiTokenId String?   @map("originating_api_token_id") @db.Uuid

  deployment          Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  createdByUser       User?      @relation("WebhookTokenCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  originatingApiToken ApiToken?  @relation("WebhookTokenOriginatingApiToken", fields: [originatingApiTokenId], references: [id], onDelete: Cascade)

  @@index([deploymentId], map: "idx_webhook_tokens_deployment")
  @@index([originatingApiTokenId], map: "idx_webhook_tokens_originating_api_token")
  @@map("deployment_webhook_tokens")
}

// A live link from a deployment to a resource it reads credentials off.
// Env values reference it as ${{resource.<name>.<field>}}; the value is
// composed at inject time, so nothing here is a snapshot of a password.
// A forge other than the GitHub App (GitLab, Gitea, Forgejo, Bitbucket, a
// self-hosted GitHub, or any https git host), linked by one person with
// their own token, the way the GitHub link is. Orchard only ever shows them
// what that token can see. The webhook secret is the boundary on the push
// path. When the person goes, apps built from it say so and someone else
// re-points them.
model GitConnection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  provider       String    @db.VarChar(20)
  name           String    @db.VarChar(80)
  baseUrl        String    @map("base_url") @db.VarChar(500)
  username       String?   @db.VarChar(255)
  token          String    @db.Text
  webhookSecret  String    @map("webhook_secret") @db.Text
  // Set when the token came from an OAuth app the instance admin registered
  // rather than a pasted token. Refreshed before it expires; the refresh
  // token is encrypted like the access token.
  oauth          Boolean   @default(false)
  refreshToken   String?   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([userId, name])
  @@index([userId], map: "idx_git_connections_user")
  @@map("git_connections")
}

