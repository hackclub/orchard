// Debounced crash/recovery state per deployment, derived from the mirrored
// `pods` rows rather than from in-process timers, so it survives shard
// failover and a crash that resolves while no replica was watching still
// resolves here. Both edges are level-triggered: a deployment is announced
// crashing once it has held a crashing pod for CRASH_CONFIRM, and recovered
// once it has held none for RECOVER_CONFIRM.
model DeploymentCrashState {
  deploymentId  String    @id @map("deployment_id") @db.Uuid
  crashingSince DateTime? @map("crashing_since") @db.Timestamp(6)
  healthySince  DateTime? @map("healthy_since") @db.Timestamp(6)
  notifiedAt    DateTime? @map("notified_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@map("deployment_crash_states")
}

// The database-side twin of `pods`. Kept as its own table rather than making
// Pod.deploymentId nullable: same shape, no migration on a hot table, and no
// rows that belong to neither thing.
//
// Before this existed the CNPG informer persisted nothing, so database health
// had to be recomputed with a live Kubernetes call on every single API request,
// and a database that OOMed while nobody had the page open left no trace.
model DatabasePod {
  id                    String    @id @default(uuid()) @db.Uuid
  databaseId            String    @map("database_id") @db.Uuid
  name                  String    @db.VarChar(255)
  podIp                 String?   @map("pod_ip") @db.VarChar(45)
  nodeName              String?   @map("node_name") @db.VarChar(255)
  status                String    @default("pending") @db.VarChar(50)
  restartCount          Int       @default(0) @map("restart_count")
  ready                 Boolean?  @map("ready")
  lastTerminationReason String?   @map("last_termination_reason") @db.VarChar(100)
  lastExitCode          Int?      @map("last_exit_code")
  lastTerminatedAt      DateTime? @map("last_terminated_at") @db.Timestamp(6)
  currentPrimary        Boolean   @default(false) @map("current_primary")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  database Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@unique([databaseId, name])
  @@index([databaseId], map: "idx_database_pods_database")
  @@index([status], map: "idx_database_pods_status")
  @@map("database_pods")
}

// Mirrors DeploymentCrashState for managed databases, so a crash that starts and
// resolves while no replica was watching still settles correctly.
model DatabaseCrashState {
  databaseId    String    @id @map("database_id") @db.Uuid
  crashingSince DateTime? @map("crashing_since") @db.Timestamp(6)
  healthySince  DateTime? @map("healthy_since") @db.Timestamp(6)
  notifiedAt    DateTime? @map("notified_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  database Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)

  @@map("database_crash_states")
}

model K8sObject {
  uid             String   @id @db.VarChar(64)
  apiVersion      String   @map("api_version") @db.VarChar(100)
  kind            String   @db.VarChar(60)
  namespace       String   @db.VarChar(100)
  name            String   @db.VarChar(255)
  resourceVersion String   @map("resource_version") @db.VarChar(30)
  // The resourceVersion whose derived state (the `pods` row, the k8s_workloads
  // row, a job run, whatever the consumer writes) has actually landed. A row is
  // only skipped on a relist when this matches `resourceVersion`, so a handler
  // that failed is retried instead of being hidden behind a manifest that is
  // already up to date.
  derivedVersion  String?  @map("derived_version") @db.VarChar(30)
  shard           String   @db.VarChar(40)
  manifest        Json     @db.JsonB
  deploymentId    String?  @map("deployment_id") @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  databaseId      String?  @map("database_id") @db.Uuid
  jobId           String?  @map("job_id") @db.Uuid
  syncedAt        DateTime @updatedAt @map("synced_at") @db.Timestamp(6)

  @@unique([kind, namespace, name, apiVersion])
  @@index([shard], map: "idx_k8s_objects_shard")
  @@index([kind, namespace], map: "idx_k8s_objects_kind_namespace")
  @@index([deploymentId], map: "idx_k8s_objects_deployment")
  @@index([projectId], map: "idx_k8s_objects_project")
  @@index([databaseId], map: "idx_k8s_objects_database")
  @@map("k8s_objects")
}

model K8sObjectTombstone {
