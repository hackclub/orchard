model K8sMirrorHeartbeat {
  shard           String    @id @db.VarChar(40)
  holder          String?   @db.VarChar(120)
  lastListAt      DateTime? @map("last_list_at") @db.Timestamp(6)
  lastEventAt     DateTime? @map("last_event_at") @db.Timestamp(6)
  lastResyncAt    DateTime? @map("last_resync_at") @db.Timestamp(6)
  resyncRepairs   Int       @default(0) @map("resync_repairs")
  resourceVersion String?   @map("resource_version") @db.VarChar(30)
  // Whether the holder's informers currently have a live watch. The heartbeat
