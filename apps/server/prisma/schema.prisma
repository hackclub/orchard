  id            String  @id @default(uuid()) @db.Uuid
  projectId     String  @map("project_id") @db.Uuid
  // The environment (and thus namespace) every child deployment lands in.
  // Null on legacy rows created before environments were threaded through the
  // compose flow; resolved to the project default at (re)deploy time.
  environmentId String? @map("environment_id") @db.Uuid
  name          String  @db.VarChar(255)
  composeYaml   String  @map("compose_yaml") @db.Text
  status        String  @default("deploying") @db.VarChar(50)
  lastError     String? @map("last_error") @db.Text

  // GitHub source: when set, the compose file is fetched from GitHub on
  // every (re)deploy and `build:` services are built into Harbor images.
  githubRepo           String? @map("github_repo") @db.VarChar(500)
  githubBranch         String? @map("github_branch") @db.VarChar(255)
  composePath          String? @map("compose_path") @db.VarChar(500)
  githubInstallationId BigInt? @map("github_installation_id")
  autoDeployEnabled    Boolean @default(false) @map("auto_deploy_enabled")
  autoDeployBranch     String? @map("auto_deploy_branch") @db.VarChar(255)
  lastCommitSha        String? @map("last_commit_sha") @db.VarChar(64)

  // Build pipeline state (mirrors Deployment build columns at the stack level).
  buildStatus String  @default("none") @map("build_status") @db.VarChar(50)
  buildLogs   String? @map("build_logs") @db.Text

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  creator     User?        @relation("ComposeStackCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  deployments Deployment[]

  @@unique([projectId, name])
  @@index([projectId], map: "idx_compose_stacks_project")
  @@index([environmentId], map: "idx_compose_stacks_environment")
  @@index([githubInstallationId, githubRepo], map: "idx_compose_stacks_github")
  @@map("compose_stacks")
}

enum SsoProtocol {
  oidc
  saml
  oauth2

  @@map("sso_protocol")
}

// One configured way in. A row with organizationId = null is instance-wide and
// renders on the platform login page for everyone; a row with an organizationId
// belongs to that org and only renders on its own login page at /<org-slug>.
// Both scopes run the exact same flows, so "Sign in with Google" for the whole
// instance and "Sign in with Acme Okta" for one org are the same object.
//
// `protocol` is how we talk to the IdP; `preset` is only which catalogue entry
// filled the form in (see sso/presets.ts). GitHub is oauth2 rather than oidc
// because it has no discovery document and no id_token.
//
// callbackPath exists because a redirect URI is a contract with the IdP, not a
// derived value: rows migrated off the old sso_configs table keep the URL their
// IdP already has registered, and everything created since derives the new one.
model IdentityProvider {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid

  slug     String      @db.VarChar(64)
  name     String      @db.VarChar(120)
  protocol SsoProtocol
  preset   String      @default("generic") @db.VarChar(32)
  enabled  Boolean     @default(true)

  buttonLabel String? @map("button_label") @db.VarChar(80)
  iconUrl     String? @map("icon_url") @db.VarChar(500)
  sortOrder   Int     @default(0) @map("sort_order")

  // OIDC / OAuth2. issuerUrl drives discovery; the explicit endpoint columns
  // are for oauth2 providers and for IdPs whose discovery document lies.
  issuerUrl        String? @map("issuer_url") @db.VarChar(500)
  clientId         String? @map("client_id") @db.VarChar(255)
  clientSecret     String? @map("client_secret") @db.Text
  scopes           String? @db.VarChar(500)
  authorizationUrl String? @map("authorization_url") @db.VarChar(500)
  tokenUrl         String? @map("token_url") @db.VarChar(500)
  userinfoUrl      String? @map("userinfo_url") @db.VarChar(500)

  // SAML 2.0
  samlEntryPoint  String? @map("saml_entry_point") @db.VarChar(500)
  samlIssuer      String? @map("saml_issuer") @db.VarChar(500)
  samlIdpEntityId String? @map("saml_idp_entity_id") @db.VarChar(500)
  samlCertificate String? @map("saml_certificate") @db.Text
  samlMetadataUrl String? @map("saml_metadata_url") @db.VarChar(500)

  callbackPath String? @map("callback_path") @db.VarChar(500)

  // Provisioning policy
  jitProvisioning      Boolean          @default(true) @map("jit_provisioning")
  defaultRole          OrganizationRole @default(member) @map("default_role")
  allowedDomains       String[]         @default([]) @map("allowed_domains")
  requireVerifiedEmail Boolean          @default(true) @map("require_verified_email")
  trustEmail           Boolean          @default(true) @map("trust_email")

  // Where the IdP puts group names: an OIDC ID-token claim (dotted path allowed)
  // or a SAML attribute name. Only read when the provider has IdpGroupRules.
  groupClaim String @default("groups") @map("group_claim") @db.VarChar(256)

  createdBy String? @map("created_by") @db.Uuid

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  organization          Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupRules            IdpGroupRule[]
  projectRules          IdpProjectRule[]
  managedProjectMembers ProjectMember[]
  autoCreateRules       IdpAutoCreateRule[]
  federatedIdentities   FederatedIdentity[]
  managedMembers        OrganizationMember[]

  @@unique([organizationId, slug])
  @@index([organizationId], map: "idx_identity_providers_org")
  @@map("identity_providers")
}

// The IdP's own stable handle for a person, bound on first login. Later logins
// match on (provider, subject) and never on email, so an IdP-side email change
// or reassignment cannot move an identity onto another account.
model FederatedIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  providerId        String   @map("provider_id") @db.Uuid
  subject           String   @db.VarChar(255)
  userId            String   @map("user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  lastLoginAt       DateTime @default(now()) @map("last_login_at") @db.Timestamp(6)
  grantedSuperadmin Boolean  @default(false) @map("granted_superadmin")

  provider IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@unique([providerId, userId])
  @@index([userId], map: "idx_federated_identities_user")
  @@map("federated_identities")
}

// Exact-match group -> (organization, role) mapping. organizationId is the org
// the rule grants into: the provider's own org for an org provider, an explicit
// target for an instance provider. Never owner (enforced in the service).
model IdpGroupRule {
  id             String           @id @default(uuid()) @db.Uuid
  providerId     String           @map("provider_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  value          String           @db.VarChar(256)
  role           OrganizationRole
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  provider     IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([providerId, organizationId, value])
  @@index([organizationId], map: "idx_idp_group_rules_org")
  @@map("idp_group_rules")
}

// Instance providers only. A login whose groups include `value` makes Orchard
// create one organization for it, once, and turns this into an ordinary
// IdpGroupRule for that organization. Inert unless the instance admin has
// switched auto-creation on.
model IdpAutoCreateRule {
  id             String           @id @default(uuid()) @db.Uuid
  providerId     String           @map("provider_id") @db.Uuid
  value          String           @db.VarChar(256)
  role           OrganizationRole
  organizationId String?          @unique @map("organization_id") @db.Uuid
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  provider     IdentityProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([providerId, value])
  @@map("idp_auto_create_rules")
}

// Org-level SSO posture, separate from any single provider so that adding a
// second IdP doesn't reopen questions already answered ("is SSO on", "is it
// mandatory", "which email domains route here").
//
// Two switches, two owners. platformEnabled belongs to the instance
// superadmin: it is how the operator turns SSO on or off for one tenant
// without touching that tenant's config. enabled belongs to the org owner.
// Login requires both, so an operator revoking access can't be undone from
// inside the org.
model OrgSsoSettings {
  organizationId String @id @map("organization_id") @db.Uuid

  // Off until a platform administrator turns it on for this tenant. SSO lets
  // an org bind an external identity source to platform accounts, so it is
  // opt-in per tenant rather than something a new org simply has.
  platformEnabled Boolean @default(false) @map("platform_enabled")
  enabled         Boolean @default(false)
  enforced        Boolean @default(false)

  loginLogoUrl      String? @map("login_logo_url") @db.VarChar(500)
  loginPrimaryColor String? @map("login_primary_color") @db.VarChar(7)
  loginBgColor      String? @map("login_bg_color") @db.VarChar(7)
  loginWelcomeText  String? @map("login_welcome_text") @db.VarChar(500)
  loginTagline      String? @map("login_tagline") @db.VarChar(500)

  guestsUseOwnLogin Boolean @default(true) @map("guests_use_own_login")
  scimOnlySignIn    Boolean @default(false) @map("scim_only_sign_in")
  maxSessionHours   Int     @default(12) @map("max_session_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_sso_settings")
}

// An email domain an organization claims, and whether it has proved it.
//
// Proof is a DNS TXT record at _orchard-challenge.<domain>, which only someone
// who controls the domain can publish. That proof is what separates "we would
// like to own these addresses" from "we do", and two things hang off it:
//
//   - routing: typing a work address on the platform login page sends you to
//     the owning org, so a tenant cannot claim gmail.com and collect the
//     traffic of everyone who types a gmail address.
//   - provisioning: an org IdP may only mint NEW accounts inside a namespace
//     the org owns. Without it, any tenant admin could point a hostile IdP at
//     ceo@bigcorp.com and pre-create that account before its real owner ever
//     signs up: the squatting half of the SSO threat model.
//
// Unverified rows are harmless placeholders; nothing reads them but the
// settings screen. Verification is exclusive: the partial unique index in the
// migration lets many orgs *claim* a domain but only one hold it.
model OrgDomain {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  domain            String    @db.VarChar(253)
  verificationToken String    @map("verification_token") @db.VarChar(80)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamp(6)
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamp(6)
  lastError         String?   @map("last_error") @db.VarChar(500)
  registeredAt      DateTime? @map("registered_at") @db.Timestamp(6)
  missingSince      DateTime? @map("missing_since") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([domain], map: "idx_org_domains_domain")
  @@map("org_domains")
}

// A destination and nothing else: where bytes go. Routing lives in
// NotificationRule, personal preference in UserNotificationSetting. The breaker
// fields are owned by the delivery worker: five consecutive failures parks the
// destination until circuitOpenUntil so one dead webhook can't starve the pool.
//
// A destination belongs to a scope the same way a rule does. scopeType 'org'
// (scopeId null) is the shared org-wide destination only an org admin can
// touch; anything narrower belongs to a project or one of its resources, so
// whoever admins that project can wire up their own webhook without waiting on
// an org admin. Only rules at or below the owning scope may point at it.
model NotificationChannel {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  scopeType      String  @default("org") @map("scope_type") @db.VarChar(20)
  scopeId        String? @map("scope_id") @db.Uuid
  name           String  @db.VarChar(100)
  type           String  @db.VarChar(20)
  config         Json    @default("{}") @db.JsonB
  enabled        Boolean @default(true)
  createdById    String? @map("created_by") @db.Uuid

  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  circuitOpenUntil    DateTime? @map("circuit_open_until") @db.Timestamp(6)
  autoDisabledAt      DateTime? @map("auto_disabled_at") @db.Timestamp(6)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamp(6)
  lastErrorAt         DateTime? @map("last_error_at") @db.Timestamp(6)
  lastError           String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?                  @relation("NotificationChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]
  rules        NotificationRule[]

  @@index([organizationId], map: "idx_notification_channels_org")
  @@index([organizationId, scopeType, scopeId], map: "idx_notification_channels_scope")
  @@map("notification_channels")
}

// Team routing. Rules are additive up the scope chain (resource -> project ->
// org); a `mute` rule at a more specific scope cancels `deliver` rules for the
// same (channel, event) at a broader one. scopeId is null iff scopeType = 'org'.
model NotificationRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  channelId      String   @map("channel_id") @db.Uuid
  scopeType      String   @map("scope_type") @db.VarChar(20)
  scopeId        String?  @map("scope_id") @db.Uuid
  events         Json     @default("[]") @db.JsonB
  mode           String   @default("deliver") @db.VarChar(10)
  enabled        Boolean  @default(true)
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator      User?               @relation("NotificationRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, scopeType, scopeId], map: "idx_notification_rules_scope")
  @@index([channelId], map: "idx_notification_rules_channel")
  @@map("notification_rules")
}

// A threshold on a metric, evaluated by the server against the metrics store.
// Sibling of NotificationRule rather than a variant of it: the rule decides
// *whether* something is wrong, and the notification pipeline decides who
// hears about it, so routing, muting, digests and replay carry over untouched.
model MetricAlertRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scopeType      String   @map("scope_type") @db.VarChar(20)
  scopeId        String?  @map("scope_id") @db.Uuid
  metric         String   @db.VarChar(40)
  // gt | lt
  comparator     String   @db.VarChar(4)
  threshold      Float
  // How long the condition must hold before it fires, and how long it must
  // clear before it resolves.
  forSeconds     Int      @default(300) @map("for_seconds")
  // A 5xx ratio on a quiet app is noise; below this many requests per second
  // the rule does not evaluate at all.
  minRequestRate Float?   @map("min_request_rate")
  enabled        Boolean  @default(true)
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?              @relation("MetricAlertRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  states       MetricAlertState[]

  @@index([organizationId, scopeType, scopeId], map: "idx_metric_alert_rules_scope")
  @@index([enabled], map: "idx_metric_alert_rules_enabled")
  @@map("metric_alert_rules")
}

// One row per (rule, deployment) the rule currently applies to. The clocks
// live here rather than in memory so an episode survives restarts and leader
// churn; `notifiedAt` is the latch that stops two evaluators both announcing
// it. The row is deleted when the episode ends, and an episode that clears
// before it was ever announced is deleted silently.
model MetricAlertState {
  id              String    @id @default(uuid()) @db.Uuid
  ruleId          String    @map("rule_id") @db.Uuid
  targetId        String    @map("target_id") @db.Uuid
  firingSince     DateTime? @map("firing_since") @db.Timestamp(6)
  okSince         DateTime? @map("ok_since") @db.Timestamp(6)
  notifiedAt      DateTime? @map("notified_at") @db.Timestamp(6)
  unknownSince    DateTime? @map("unknown_since") @db.Timestamp(6)
  lastValue       Float?    @map("last_value")
  lastEvaluatedAt DateTime? @map("last_evaluated_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  rule MetricAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, targetId], map: "uq_metric_alert_state_rule_target")
  @@index([targetId], map: "idx_metric_alert_states_target")
  @@map("metric_alert_states")
}

// A public page that reads an org's apps and databases as a list of
// components with a status. Nothing on it is stored as state: every field a
// visitor sees is derived at read time from the crash states, the mirrored
// workloads, the alert states and the pod transitions, so it can never say
// "operational" about something the platform already knows is down.
model StatusPage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  slug           String   @unique @db.VarChar(64)
  title          String   @db.VarChar(120)
  description    String?  @db.VarChar(500)
  // Optional host under BASE_DOMAIN; the ingress is created after the row
  // commits, as the vanity domain does.
  subdomain      String?  @unique @db.VarChar(100)
  isPublic       Boolean  @default(true) @map("is_public")
  // Ordered [{ id, kind: 'deployment' | 'database', resourceId, name }]
  components     Json     @default("[]") @db.JsonB
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_status_pages_org")
  @@map("status_pages")
}

// Personal preference, Sentry-style fine tuning. One row per (user, scope,
// category); absent rows inherit the next broader scope and finally the system
// default 'subscribed'. Never suppresses a NotificationRule, only the personal lane.
model UserNotificationSetting {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  scopeType String   @map("scope_type") @db.VarChar(20)
  // Not a uuid column and not nullable: Postgres treats NULLs as distinct in a
  // unique index, so a nullable scope would let the same global preference be
  // inserted over and over. The account-wide row stores the literal 'global'.
  scopeId   String   @map("scope_id") @db.VarChar(64)
  category  String   @db.VarChar(20)
  value     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId, category], map: "uq_user_notification_setting")
  @@index([userId], map: "idx_user_notification_settings_user")
  @@map("user_notification_settings")
}

// Where a person's own notifications go. The implicit email destination is
// seeded from User.email on first save; webhook destinations pass the same SSRF
// guard as org channels and carry their own breaker state.
model UserNotificationDestination {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  type    String  @db.VarChar(20)
  config  Json    @default("{}") @db.JsonB
  enabled Boolean @default(true)

  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  circuitOpenUntil    DateTime? @map("circuit_open_until") @db.Timestamp(6)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamp(6)
  lastErrorAt         DateTime? @map("last_error_at") @db.Timestamp(6)
  lastError           String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId], map: "idx_user_notification_destinations_user")
  @@map("user_notification_destinations")
}

// The outbox. One row per real-world state transition, keyed by a natural
// dedupeKey so racing replicas insert once. Retains the rendered payload for 30
// days, which is what makes replay-after-an-outage possible.
model NotificationEvent {
  id             String    @id @default(uuid()) @db.Uuid
  // Null for an event about a person rather than about org infrastructure: a
  // sign-in belongs to an account, not to any one organization that account is
  // a member of, and an org-filtered read must never pick it up.
  organizationId String?   @map("organization_id") @db.Uuid
  event          String    @db.VarChar(50)
  scopeType      String    @map("scope_type") @db.VarChar(20)
  scopeId        String?   @map("scope_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  payload        Json      @db.JsonB
  dedupeKey      String    @unique(map: "uq_notification_events_dedupe") @map("dedupe_key") @db.VarChar(200)
  status         String    @default("pending") @db.VarChar(20)
  lockedBy       String?   @map("locked_by") @db.VarChar(120)
  lockedAt       DateTime? @map("locked_at") @db.Timestamp(6)
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamp(6)
  fannedOutAt    DateTime? @map("fanned_out_at") @db.Timestamp(6)

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([status, occurredAt], map: "idx_notification_events_pending")
  @@index([organizationId, occurredAt], map: "idx_notification_events_org")
  @@map("notification_events")
}

// One row per (event, destination). The unique constraint is what makes fanout
// exactly-once across crashes and replicas; sending itself is at-least-once.
model NotificationDelivery {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  destinationKey String @map("destination_key") @db.VarChar(120)

  channelId  String? @map("channel_id") @db.Uuid
  userDestId String? @map("user_destination_id") @db.Uuid
  userId     String? @map("user_id") @db.Uuid

  event    String  @db.VarChar(50)
  targetId String? @map("target_id") @db.Uuid

  status        String    @default("pending") @db.VarChar(20)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamp(6)
  lockedBy      String?   @map("locked_by") @db.VarChar(120)
  lockedAt      DateTime? @map("locked_at") @db.Timestamp(6)

  httpStatus     Int?      @map("http_status")
  error          String?   @db.Text
  coalescedInto  String?   @map("coalesced_into") @db.Uuid
  coalescedCount Int?      @map("coalesced_count")
  firstAttemptAt DateTime? @map("first_attempt_at") @db.Timestamp(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamp(6)
  durationMs     Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  notificationEvent NotificationEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel           NotificationChannel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userDestination   UserNotificationDestination? @relation(fields: [userDestId], references: [id], onDelete: Cascade)

  @@unique([eventId, destinationKey], map: "uq_notification_deliveries_event_dest")
  @@index([status, nextAttemptAt], map: "idx_notification_deliveries_claim")
  @@index([channelId, createdAt], map: "idx_notification_deliveries_lookup")
  @@index([userId, createdAt], map: "idx_notification_deliveries_user")
  @@map("notification_deliveries")
}

// Long-lived bearer credential an IdP presents to the SCIM endpoints. Scoped to
// one org; only the sha256 digest is stored (mirrors ApiToken). The plaintext is
// shown once at mint time. lastUsedAt powers "is this connector still live".
model InstanceScimToken {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(255)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  createdBy  String?   @map("created_by") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamp(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("instance_scim_tokens")
}

model ScimToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(255)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  createdBy      String?   @map("created_by") @db.Uuid
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamp(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_scim_tokens_org")
  @@map("scim_tokens")
}

// A membership an IdP has deactivated with `active: false`. RFC 7644 treats
// deactivation as a state change, not a delete: the resource stays readable and
// the same id has to come back to life on `active: true`. We still drop the
// organization_members row so access is genuinely revoked, and park the SCIM
// identity here: reusing the old membership id as the primary key keeps the
// SCIM resource id stable across deactivate/reactivate. DELETE clears both.
model ScimDeprovisionedMember {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  externalId     String?          @map("external_id") @db.VarChar(255)
  role           OrganizationRole @default(member)
  enterprise     Json?            @map("enterprise")
  userName       String?          @map("user_name") @db.VarChar(255)
  givenName      String?          @map("given_name") @db.VarChar(255)
  familyName     String?          @map("family_name") @db.VarChar(255)
  displayName    String?          @map("display_name") @db.VarChar(255)
  deactivatedAt  DateTime         @default(now()) @map("deactivated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId], map: "idx_scim_deprovisioned_org")
  @@map("scim_deprovisioned_members")
}

model ScimGroup {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name") @db.VarChar(256)
  externalId     String?  @map("external_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ScimGroupMember[]

  @@unique([organizationId, displayName])
  @@index([organizationId], map: "idx_scim_groups_org")
  @@map("scim_groups")
}

model ScimGroupMember {
  groupId        String @map("group_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  group        ScimGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([organizationId, userId], map: "idx_scim_group_members_org_user")
  @@map("scim_group_members")
}

// Append-only audit ledger. Pruned at 180 days by AuditService.
// Lightweight by design: no full row snapshots, metadata is small JSON.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  // Verb-style action key, e.g. "deployment.created", "org.member.role_changed".
  action         String   @db.VarChar(80)
  // Who did it. Null = system / unauthenticated action.
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorEmail     String?  @map("actor_email") @db.VarChar(255)
  // Scoping. All three nullable: a global event has no org, a project event has no deployment, etc.
  organizationId String?  @map("organization_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  deploymentId   String?  @map("deployment_id") @db.Uuid
  // Generic target reference for things outside the three FKs (e.g. user, member, token).
  targetType     String?  @map("target_type") @db.VarChar(40)
  targetId       String?  @map("target_id") @db.VarChar(64)
  targetLabel    String?  @map("target_label") @db.VarChar(255)
  // Small structured context, e.g. {"role":["member","admin"]}. Capped at ~2KB by service.
  metadata       Json?    @db.JsonB

  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created")
  @@index([organizationId, createdAt(sort: Desc)], map: "idx_audit_logs_org")
  @@index([projectId, createdAt(sort: Desc)], map: "idx_audit_logs_project")
  @@index([deploymentId, createdAt(sort: Desc)], map: "idx_audit_logs_deployment")
  @@index([actorUserId, createdAt(sort: Desc)], map: "idx_audit_logs_actor")
  @@map("audit_logs")
}

// Cluster nodes managed by admins. Synced from Kubernetes on demand.
model Node {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique @db.VarChar(255)
  labels         Json?     @db.JsonB
  // Live node taints (`spec.taints`): array of { key, value?, effect }.
  // Reflected from the cluster by the node informer; edited via patchNode.
  taints         Json?     @db.JsonB
  schedulable    Boolean   @default(true)
  notes          String?   @db.Text
  // Optional admin-set caps (overrides measured capacity when enforcing quotas)
  cpuCapacity    String?   @map("cpu_capacity") @db.VarChar(32)
  memoryCapacity String?   @map("memory_capacity") @db.VarChar(32)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  assignments OrgNodeAssignment[]

  @@map("nodes")
}

enum NodePoolAffinityMode {
  required
  preferred
}

// A superadmin-defined scheduling lane. Maps a friendly name to a node
// label selector plus optional tolerations to inject, so a workload can be
// assigned to the pool without ever seeing raw taints/labels. `userSelectable`
// lets tenants pick it (only when USERSPACE_NODE_SCHEDULING is enabled).
model NodePool {
  id             String               @id @default(uuid()) @db.Uuid
  name           String               @db.VarChar(255)
  slug           String               @unique @db.VarChar(255)
  description    String?              @db.Text
  // nodeSelector: array of { key, operator, values? } matchExpressions
  // (kubernetes.io/hostname is reserved for org allow/deny; use custom labels).
  nodeSelector   Json                 @default("[]") @db.JsonB
  // tolerations: array of { key, operator?, value?, effect? } injected into
  // every pod assigned to this pool, so it can land on tainted nodes.
  tolerations    Json                 @default("[]") @db.JsonB
  affinityMode   NodePoolAffinityMode @default(preferred)
  userSelectable Boolean              @default(false) @map("user_selectable")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)

  deployments Deployment[]
  jobs        Job[]
  databases   Database[]

  @@map("node_pools")
}

enum NodeAssignmentMode {
  allow
  deny
}

// Per-(org, node) placement + quota rule.
// If an org has any ALLOW rows, it can only place on those nodes. DENY excludes a node.
model OrgNodeAssignment {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  nodeId         String             @map("node_id") @db.Uuid
  mode           NodeAssignmentMode @default(allow)
  // Quota (nullable = unlimited). CPU in cores (e.g. "2"), memory (e.g. "4Gi").
  cpuLimit       String?            @map("cpu_limit") @db.VarChar(32)
  memoryLimit    String?            @map("memory_limit") @db.VarChar(32)
  maxServices    Int?               @map("max_services")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  node         Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, nodeId])
  @@index([nodeId], map: "idx_org_node_assignments_node")
  @@index([organizationId], map: "idx_org_node_assignments_org")
  @@map("org_node_assignments")
}

// Generic instance-level (self-host) settings, keyed by a stable string.
// Superadmin-managed from the admin panel; a matching env var overrides the
// stored value at read time (see InstanceSettingsService).
model InstanceSetting {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("instance_settings")
}

model GraftMigration {
  graftId   String   @map("graft_id") @db.VarChar(48)
  name      String   @db.VarChar(255)
  checksum  String   @db.Char(64)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@id([graftId, name])
  @@map("graft_migrations")
}

model GraftArtifact {
  digest    String   @id @db.VarChar(80)
  graftId   String   @map("graft_id") @db.VarChar(48)
  version   String   @db.VarChar(64)
  size      Int
  content   Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([graftId])
  @@map("graft_artifacts")
}

model McpOauthClient {
  id           String    @id @db.VarChar(64)
  clientSecret String?   @map("client_secret") @db.VarChar(128)
  name         String    @db.VarChar(255)
  redirectUris Json      @map("redirect_uris")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamp(6)

  @@map("mcp_oauth_clients")
}

// Short-lived OAuth authorization-code and pending-authorize state. Held in
// Postgres rather than process memory so the flow survives MCP restarts and
// works across replicas: the `/authorize` -> `/authorize/complete` -> `/token`
// hops can each land on a different process. `id` is the lookup key: the
// one-time auth code, or `pending_<state>` / `client_state_<state>` for the
// in-flight authorize handshake. Rows are single-use (deleted on exchange) and
// swept once expired.
model McpOauthCode {
  id                  String   @id @db.VarChar(191)
  clientId            String   @map("client_id") @db.Text
  redirectUri         String   @default("") @map("redirect_uri") @db.Text
  codeChallenge       String?  @map("code_challenge") @db.Text
  codeChallengeMethod String?  @map("code_challenge_method") @db.VarChar(16)
  orchardToken        String   @default("") @map("orchard_token") @db.Text
  expiresAt           DateTime @map("expires_at") @db.Timestamp(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([expiresAt], map: "idx_mcp_oauth_codes_expires_at")
  @@map("mcp_oauth_codes")
}

// Error groups are ingested server-side by a leader-elected sweep so history
// survives redeploys and accumulates whether or not anyone is watching. A
// group is unique per (deployment, fingerprint); occurrences roll up per
// deploy so "seen in N deploys" and "introduced in <sha>" are real joins.
model ErrorGroup {
  id                  String    @id @default(uuid()) @db.Uuid
  deploymentId        String    @map("deployment_id") @db.Uuid
  fingerprint         String    @db.VarChar(64)
  type                String    @db.VarChar(200)
  message             String    @db.Text
  status              String    @default("unresolved") @db.VarChar(20)
  assigneeId          String?   @map("assignee_id") @db.Uuid
  githubIssueUrl      String?   @map("github_issue_url") @db.VarChar(500)
  githubIssueNumber   Int?      @map("github_issue_number")
  totalCount          Int       @default(0) @map("total_count")
  firstSeenAt         DateTime  @map("first_seen_at") @db.Timestamp(6)
  lastSeenAt          DateTime  @map("last_seen_at") @db.Timestamp(6)
  firstImageHistoryId String?   @map("first_image_history_id") @db.Uuid
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamp(6)
  resolvedById        String?   @map("resolved_by_id") @db.Uuid
  sampleStack         String?   @map("sample_stack") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  deployment        Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  assignee          User?             @relation("ErrorGroupAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedBy        User?             @relation("ErrorGroupResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  firstImageHistory ImageHistory?     @relation(fields: [firstImageHistoryId], references: [id], onDelete: SetNull)
  occurrences       ErrorOccurrence[]

  @@unique([deploymentId, fingerprint], map: "uq_error_group_deployment_fingerprint")
  @@index([deploymentId, status], map: "idx_error_group_deployment_status")
  @@index([deploymentId, lastSeenAt(sort: Desc)], map: "idx_error_group_deployment_last_seen")
  @@index([lastSeenAt], map: "idx_error_group_last_seen")
  @@map("error_groups")
}

model ErrorOccurrence {
  id             String   @id @default(uuid()) @db.Uuid
  errorGroupId   String   @map("error_group_id") @db.Uuid
  imageHistoryId String?  @map("image_history_id") @db.Uuid
  count          Int      @default(0)
  firstSeenAt    DateTime @map("first_seen_at") @db.Timestamp(6)
  lastSeenAt     DateTime @map("last_seen_at") @db.Timestamp(6)

  errorGroup   ErrorGroup    @relation(fields: [errorGroupId], references: [id], onDelete: Cascade)
  imageHistory ImageHistory? @relation(fields: [imageHistoryId], references: [id], onDelete: SetNull)

  @@unique([errorGroupId, imageHistoryId], map: "uq_error_occurrence_group_image")
  @@index([errorGroupId], map: "idx_error_occurrence_group")
  @@map("error_occurrences")
}
