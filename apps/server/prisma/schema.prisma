generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(uuid()) @db.Uuid
  externalAuthId              String?   @unique @map("hackclub_id") @db.VarChar(255)
  email                       String    @db.VarChar(255)
  emailScope                  String    @default("account") @map("email_scope") @db.VarChar(64)
  homeOrganizationId          String?   @map("home_organization_id") @db.Uuid
  username                    String    @unique @db.VarChar(100)
  passwordHash                String?   @map("password_hash") @db.VarChar(255)
  firstName                   String?   @map("first_name") @db.VarChar(100)
  lastName                    String?   @map("last_name") @db.VarChar(100)
  imageUrl                    String?   @map("image_url") @db.VarChar(500)
  // Where imageUrl came from: 'upload' (the user picked it), 'gravatar' (found
  // by email lookup and cached to R2), or 'none' (they deleted one and do not
  // want it re-imported). Null means never resolved, so a lookup is due.
  imageSource                 String?   @map("image_source") @db.VarChar(20)
  avatarCheckedAt             DateTime? @map("avatar_checked_at") @db.Timestamp(6)
  githubId                    String?   @unique @map("github_id") @db.VarChar(255)
  githubUsername              String?   @map("github_username") @db.VarChar(255)
  githubAccessToken           String?   @map("github_access_token") @db.Text
  githubTokenExpiresAt        DateTime? @map("github_token_expires_at") @db.Timestamp(6)
  githubRefreshToken          String?   @map("github_refresh_token") @db.Text
  githubRefreshTokenExpiresAt DateTime? @map("github_refresh_token_expires_at") @db.Timestamp(6)
  isSuperAdmin                Boolean   @default(false) @map("is_super_admin")
  maxSandboxes                Int?      @map("max_sandboxes")
  setupCompleted              Boolean   @default(false) @map("setup_completed")
  emailVerified               Boolean   @default(false) @map("email_verified")
  emailVerifiedAt             DateTime? @map("email_verified_at") @db.Timestamp(6)
  emailVerifiedVia            String?   @map("email_verified_via") @db.VarChar(20)
  disabledAt                  DateTime? @map("disabled_at") @db.Timestamp(6)
  disabledReason              String?   @map("disabled_reason") @db.VarChar(255)
  scimExternalId              String?   @map("scim_external_id") @db.VarChar(255)
  passkeyOnly                 Boolean   @default(false) @map("passkey_only")
  seenUpdates                 String[]  @default([]) @map("seen_updates")
  setupSkipped                String[]  @default([]) @map("setup_skipped")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  createdProjects            Project[]                     @relation("ProjectCreator")
  ownedProjects              Project[]                     @relation("ProjectOwner")
  projectMembers             ProjectMember[]
  projectInvitations         ProjectInvitation[]           @relation("ProjectInvitedBy")
  receivedProjectInvitations ProjectInvitation[]           @relation("ProjectInvitedUser")
  addedProjectMembers        ProjectMember[]               @relation("ProjectMemberAdder")
  sentProjectTransfers       ProjectTransferRequest[]      @relation("ProjectTransferFrom")
  receivedProjectTransfers   ProjectTransferRequest[]      @relation("ProjectTransferTo")
  createdDeployments         Deployment[]                  @relation("DeploymentCreator")
  createdOrganizations       Organization[]                @relation("OrganizationCreator")
  organizationMembers        OrganizationMember[]
  scimDeprovisionedMembers   ScimDeprovisionedMember[]
  scimGroupMemberships       ScimGroupMember[]
  orgInvitationsSent         OrganizationInvitation[]      @relation("OrgInvitationInviter")
  passkeys                   Passkey[]
  sessions                   Session[]
  federatedIdentities        FederatedIdentity[]
  githubAppInstallations     GitHubAppInstallation[]
  gitConnections             GitConnection[]
  createdDatabases           Database[]                    @relation("DatabaseCreator")
  apiTokens                  ApiToken[]
  createdTemplateInstances   TemplateInstance[]            @relation("TemplateInstanceCreator")
  createdComposeStacks       ComposeStack[]                @relation("ComposeStackCreator")
  triggeredBuilds            ImageHistory[]
  assignedErrorGroups        ErrorGroup[]                  @relation("ErrorGroupAssignee")
  resolvedErrorGroups        ErrorGroup[]                  @relation("ErrorGroupResolver")
  triggeredBuildRuns         BuildRun[]                    @relation("BuildRunTrigger")
  releases                   Release[]                     @relation("ReleaseCreator")
  metricAlertRules           MetricAlertRule[]             @relation("MetricAlertRuleCreator")
  createdWebhookTokens       DeploymentWebhookToken[]      @relation("WebhookTokenCreator")
  tailscaleConnection        TailscaleConnection?
  createdJobs                Job[]                         @relation("JobCreator")
  triggeredJobRuns           JobRun[]                      @relation("JobRunTrigger")
  notificationSettings       UserNotificationSetting[]
  notificationDestinations   UserNotificationDestination[]
  createdNotificationRules   NotificationRule[]            @relation("NotificationRuleCreator")
  createdChannels            NotificationChannel[]         @relation("NotificationChannelCreator")
  homeOrganization           Organization?                 @relation("OrgIdentities", fields: [homeOrganizationId], references: [id], onDelete: Cascade)
  linkedIdentities           AccountLink[]                 @relation("AccountLinkAccount")
  linkedAccount              AccountLink?                  @relation("AccountLinkIdentity")

  @@unique([emailScope, email])
  @@index([homeOrganizationId], map: "idx_users_home_organization")
  @@map("users")
}

model TailscaleConnection {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  accessToken     String   @map("access_token") @db.Text
  refreshToken    String?  @map("refresh_token") @db.Text
  tailnet         String   @db.VarChar(255)
  tailscaleUserId String?  @map("tailscale_user_id") @db.VarChar(255)
  displayName     String?  @map("display_name") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_tailscale_connections_user")
  @@map("tailscale_connections")
}

model ApiToken {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(255)
  // sha256 hex digest of the plaintext token. Plaintext is never persisted:
  // a DB compromise (read replica, backup leak) yields hashes, not working
  // credentials. Lookup is by hash, so authentication still hits one indexed row.
  tokenHash            String    @unique @map("token_hash") @db.VarChar(128)
  // List of capability scopes (e.g. ["read"], ["read","exec"]). Empty array
  // means read-only. Sensitive surfaces (terminal exec) require explicit scope.
  scopes               Json      @default("[]") @map("scopes")
  // Optional project allowlist. Empty array = token can touch any project the
  // owning user has access to (legacy behaviour). Non-empty = token is rejected
  // for any project not in this list, regardless of the user's underlying role.
  // IDs are not FK-enforced: project deletion is rare, and a stale ID is simply
  // unmatchable, which is the safe direction.
  restrictedProjectIds String[]  @default([]) @map("restricted_project_ids") @db.Uuid
  scopeOrganizationId  String?   @map("scope_organization_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  parentTokenId        String?   @map("parent_token_id") @db.Uuid
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamp(6)
  expiresAt            DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent                  ApiToken?                @relation("ApiTokenLineage", fields: [parentTokenId], references: [id], onDelete: Cascade)
  children                ApiToken[]               @relation("ApiTokenLineage")
  // H-3: when this API token is deleted (revocation or user removal),
  // cascade-delete any webhooks it minted so the trigger surface dies with
  // the parent credential. See DeploymentWebhookToken.originatingApiTokenId.
  originatedWebhookTokens DeploymentWebhookToken[] @relation("WebhookTokenOriginatingApiToken")

  @@index([userId], map: "idx_api_tokens_user")
  @@index([tokenHash], map: "idx_api_tokens_token_hash")
  @@index([parentTokenId], map: "idx_api_tokens_parent")
  @@map("api_tokens")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.Text
  deviceName        String?   @map("device_name") @db.VarChar(255)
  location          String?   @db.VarChar(255)
  authMethod        String?   @map("auth_method") @db.VarChar(20)
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamp(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamp(6)
  refreshGeneration Int       @default(0) @map("refresh_generation")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgGrants SessionOrgGrant[]

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

// GitHub App installations - tracks when users install the GitHub App on their repos
model GitHubAppInstallation {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  installationId      BigInt    @unique @map("installation_id")
  accountLogin        String    @map("account_login") @db.VarChar(255)
  accountId           BigInt    @map("account_id")
  accountType         String    @map("account_type") @db.VarChar(50)
  accessToken         String?   @map("access_token") @db.Text
  tokenExpiresAt      DateTime? @map("token_expires_at") @db.Timestamp(6)
  repositorySelection String    @default("all") @map("repository_selection") @db.VarChar(50)
  suspendedAt         DateTime? @map("suspended_at") @db.Timestamp(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  repos GitHubRepoMirror[]

  @@index([userId], map: "idx_github_app_installations_user")
  @@index([accountLogin], map: "idx_github_app_installations_account")
  @@index([accountId], map: "idx_github_app_installations_account_id")
  @@map("github_app_installations")
}

model GitHubRepoMirror {
  id                String    @id @default(uuid()) @db.Uuid
  appInstallationId String    @map("app_installation_id") @db.Uuid
  githubRepoId      BigInt    @map("github_repo_id")
  fullName          String    @map("full_name") @db.VarChar(255)
  private           Boolean   @default(false)
  defaultBranch     String?   @map("default_branch") @db.VarChar(255)
  pushedAt          DateTime? @map("pushed_at") @db.Timestamp(6)
  syncedAt          DateTime  @default(now()) @map("synced_at") @db.Timestamp(6)

  installation GitHubAppInstallation @relation(fields: [appInstallationId], references: [id], onDelete: Cascade)

  @@unique([appInstallationId, githubRepoId])
  @@index([appInstallationId, pushedAt(sort: Desc)], map: "idx_github_repo_mirror_pushed")
  @@map("github_repo_mirror")
}

// OTP codes for email-based authentication
model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(64) // Hashed OTP code
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  attempts  Int      @default(0) // Track verification attempts
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([email], map: "idx_otp_codes_email")
  @@index([expiresAt], map: "idx_otp_codes_expires")
  @@map("otp_codes")
}

// Rate limiting records for brute force protection
model RateLimitRecord {
  id           String    @id @default(uuid()) @db.Uuid
  identifier   String    @db.VarChar(255) // Email or IP address
  type         String    @db.VarChar(50) // "email" or "ip"
  action       String    @db.VarChar(50) // "otp_request", "otp_verify", "passkey_auth"
  count        Int       @default(1)
  windowStart  DateTime  @default(now()) @map("window_start") @db.Timestamp(6)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamp(6)

  @@unique([identifier, type, action])
  @@index([identifier, type, action], map: "idx_rate_limit_lookup")
  @@index([windowStart], map: "idx_rate_limit_window")
  @@map("rate_limit_records")
}

// WebAuthn Passkeys for passwordless authentication
model Passkey {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id") @db.Text // Base64URL encoded credential ID
  publicKey    String    @map("public_key") @db.Text // Base64URL encoded public key
  counter      BigInt    @default(0) // Sign count for replay protection
  deviceType   String    @map("device_type") @db.VarChar(32) // "singleDevice" or "multiDevice"
  backedUp     Boolean   @default(false) @map("backed_up")
  transports   String[]  @default([]) // Array of transport hints (usb, ble, nfc, internal)
  aaguid       String?   @db.VarChar(36) // Authenticator AAGUID
  friendlyName String?   @map("friendly_name") @db.VarChar(255) // User-provided name for the passkey
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_passkeys_user")
  @@index([credentialId], map: "idx_passkeys_credential")
  @@map("passkeys")
}

// WebAuthn challenges for registration and authentication
model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  challenge String   @unique @db.Text // Base64URL encoded challenge
  type      String   @db.VarChar(20) // "registration" or "authentication"
  email     String?  @db.VarChar(255) // Email for registration/auth flow
  userId    String?  @map("user_id") @db.Uuid // User ID if known
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([challenge], map: "idx_webauthn_challenges_challenge")
  @@index([expiresAt], map: "idx_webauthn_challenges_expires")
  @@map("webauthn_challenges")
}

model Organization {
  registryCredentials OrganizationRegistryCredential[]
  id                  String                           @id @default(uuid()) @db.Uuid
  name                String                           @db.VarChar(255)
  slug                String                           @unique @db.VarChar(100)
  description         String?                          @db.Text
  avatarUrl           String?                          @map("avatar_url") @db.VarChar(500)
  plan                String?                          @db.VarChar(50)
  // Vanity host only. SSO lives at /<slug> on the main domain; a subdomain
  // that still resolves just redirects there.
  subdomain           String?                          @unique @db.VarChar(100)
  createdBy           String?                          @map("created_by") @db.Uuid
  createdAt           DateTime                         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime                         @updatedAt @map("updated_at") @db.Timestamp(6)

  backupR2Endpoint  String? @map("backup_r2_endpoint") @db.VarChar(500)
  backupR2Bucket    String? @map("backup_r2_bucket") @db.VarChar(255)
  backupR2Region    String? @map("backup_r2_region") @db.VarChar(100)
  backupR2AccessKey String? @map("backup_r2_access_key") @db.VarChar(255)
  backupR2SecretKey String? @map("backup_r2_secret_key") @db.Text

  databasePublicIp String? @map("database_public_ip") @db.VarChar(45)

  postgresAutoUpdate Boolean @default(false) @map("postgres_auto_update")

  // Org-wide resource caps (null = unlimited). CPU in millicores, memory in bytes.
  cpuLimitMilli    Int?    @map("cpu_limit_milli")
  memoryLimitBytes BigInt? @map("memory_limit_bytes")
  maxPods          Int?    @map("max_pods")
  maxServices      Int?    @map("max_services")

  // Most projects, extra environments and deployments the org may hold (null = unlimited).
  maxProjects     Int? @map("max_projects")
  maxEnvironments Int? @map("max_environments")
  maxDeployments  Int? @map("max_deployments")

  // Per-project defaults applied via LimitRange (null = no default).
  defaultPodCpuMilli    Int?    @map("default_pod_cpu_milli")
  defaultPodMemoryBytes BigInt? @map("default_pod_memory_bytes")

  // Default per-member resource allowance handed to new members (null = unlimited default).
  defaultMemberCpuMilli    Int?    @map("default_member_cpu_milli")
  defaultMemberMemoryBytes BigInt? @map("default_member_memory_bytes")

  // Connected orgs share the same caps and the same usage pool. All orgs with the
  // same quotaGroupId mirror caps and aggregate usage when admission-checking.
  quotaGroupId String? @map("quota_group_id") @db.Uuid

  creator              User?                     @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  members              OrganizationMember[]
  invitations          OrganizationInvitation[]
  projects             Project[]
  ssoSettings          OrgSsoSettings?
  identityProviders    IdentityProvider[]
  identities           User[]                    @relation("OrgIdentities")
  accountLinks         AccountLink[]
  sessionGrants        SessionOrgGrant[]
  idpProjectRules      IdpProjectRule[]
  idpGroupRules        IdpGroupRule[]
  idpAutoCreateRule    IdpAutoCreateRule?
  domains              OrgDomain[]
  nodeAssignments      OrgNodeAssignment[]
  scimTokens           ScimToken[]
  scimDeprovisioned    ScimDeprovisionedMember[]
  scimGroups           ScimGroup[]
  scimGroupMembers     ScimGroupMember[]
  notificationChannels NotificationChannel[]
  notificationRules    NotificationRule[]
  notificationEvents   NotificationEvent[]
  metricAlertRules     MetricAlertRule[]
  statusPages          StatusPage[]

  @@index([quotaGroupId], map: "idx_organizations_quota_group")
  @@map("organizations")
}

enum MemberStatus {
  active
  disabled

  @@map("member_status")
}

enum MemberSource {
  invite
  sso
  scim
  rule
  direct

  @@map("member_source")
}

enum OrganizationRole {
  owner
  admin
  member
  guest

  @@map("organization_role")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(member)
  addedAt        DateTime         @default(now()) @map("added_at") @db.Timestamp(6)
  addedBy        String?          @map("added_by") @db.Uuid

  // Per-member resource allowance. Null + unlimited=false ⇒ inherit org default.
  cpuAllowanceMilli        Int?    @map("cpu_allowance_milli")
  memoryAllowanceBytes     BigInt? @map("memory_allowance_bytes")
  cpuAllowanceUnlimited    Boolean @default(false) @map("cpu_allowance_unlimited")
  memoryAllowanceUnlimited Boolean @default(false) @map("memory_allowance_unlimited")

  // SCIM provisioning state. A membership is the unit an IdP provisions: SCIM
  // resource id = this row's id. scimExternalId is the IdP's stable handle for
  // the user (carried in `externalId`); scimManaged flags rows created via SCIM
  // so deprovisioning (active:false / DELETE) only removes IdP-owned memberships.
  scimExternalId String? @map("scim_external_id") @db.VarChar(255)
  scimManaged    Boolean @default(false) @map("scim_managed")
  // Raw enterprise-extension payload (department, manager, costCenter, …). We
  // have no column for any of it, so it round-trips verbatim: an IdP that
  // writes it reads the same thing back.
  scimEnterprise Json?   @map("scim_enterprise")

  // Per-org profile the IdP owns. The SCIM resource is this membership, but
  // userName/firstName/lastName live on the shared User row that every other
  // org also reads: writing there let one org's IdP rename someone everywhere,
  // and made RFC 7644 replace-on-omit unsafe to implement. SCIM writes the User
  // row only when it creates the account; after that it owns these instead.
  scimUserName    String? @map("scim_user_name") @db.VarChar(255)
  scimGivenName   String? @map("scim_given_name") @db.VarChar(255)
  scimFamilyName  String? @map("scim_family_name") @db.VarChar(255)
  scimDisplayName String? @map("scim_display_name") @db.VarChar(255)

  // Set when an IdP group rule decided this membership's role. Rules may then
  // lower or remove it on a later login; memberships made any other way
  // (invite, direct add) are never removed by a rule, only re-roled when the
  // user matches one.
  managedByProviderId String? @map("managed_by_provider_id") @db.Uuid

  status         MemberStatus  @default(active)
  disabledAt     DateTime?     @map("disabled_at") @db.Timestamp(6)
  disabledReason String?       @map("disabled_reason") @db.VarChar(255)
  source         MemberSource?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedByProvider IdentityProvider? @relation(fields: [managedByProviderId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([managedByProviderId], map: "idx_organization_members_managed_by")
  @@index([organizationId], map: "idx_organization_members_org")
  @@index([userId], map: "idx_organization_members_user")
  @@index([organizationId, scimExternalId], map: "idx_organization_members_scim_external")
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(255)
  role           OrganizationRole @default(member)
  // Legacy plaintext column. Nullable: the 20260515180100 migration
  // nulled every backfilled row so a DB-read foothold can't mint working
  // invite links. New code writes NULL here; lookups use `tokenHash`.
  token          String?          @unique @db.VarChar(255)
  // SHA-256 hex digest of the plaintext token. Source of truth for lookups.
  tokenHash      String           @unique @map("token_hash") @db.VarChar(128)
  invitedBy      String           @map("invited_by") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamp(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  // Optional project target. Set when the invite was issued from a project's
  // members page for an email with no existing account: on accept the user
  // joins the org with `role` (guest) AND becomes a member of this project
  // with `projectRoleId`.
  projectId      String?          @map("project_id") @db.Uuid
  projectRoleId  String?          @map("project_role_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("OrgInvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRole  Role?        @relation(fields: [projectRoleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId], map: "idx_organization_invitations_org")
  @@index([email], map: "idx_organization_invitations_email")
  @@index([token], map: "idx_organization_invitations_token")
  @@index([projectId], map: "idx_organization_invitations_project")
  @@map("organization_invitations")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  projectMembers     ProjectMember[]
  projectInvitations ProjectInvitation[]
  orgInvitations     OrganizationInvitation[]
  idpProjectRules    IdpProjectRule[]

  @@map("roles")
}

model AccountLink {
  id             String   @id @default(uuid()) @db.Uuid
  identityUserId String   @unique @map("identity_user_id") @db.Uuid
  accountUserId  String   @map("account_user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  identity     User         @relation("AccountLinkIdentity", fields: [identityUserId], references: [id], onDelete: Cascade)
  account      User         @relation("AccountLinkAccount", fields: [accountUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([accountUserId, organizationId])
  @@map("account_links")
}

model SessionOrgGrant {
  sessionId      String   @map("session_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  providerId     String?  @map("provider_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamp(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([sessionId, organizationId])
  @@index([expiresAt], map: "idx_session_org_grants_expires")
  @@map("session_org_grants")
}

model IdpProjectRule {
  id             String   @id @default(uuid()) @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
