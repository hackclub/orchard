  healthy         Boolean   @default(true)
  lastError       String?   @map("last_error") @db.VarChar(300)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("k8s_mirror_heartbeats")
}

